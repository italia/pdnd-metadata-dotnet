<Project>

  <PropertyGroup>
    <!-- Single source of truth for the version of every shipped package. -->
    <VersionPrefix>2.1.0</VersionPrefix>

    <!-- Package identity -->
    <Authors>Francesco Del Re</Authors>
    <Company>Francesco Del Re</Company>
    <Copyright>Copyright (c) 2026 Francesco Del Re</Copyright>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/italia/pdnd-metadata-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/italia/pdnd-metadata-dotnet</PackageProjectUrl>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Icon shown on nuget.org. NuGet does not accept SVG, so assets/icon.png is a 256 px render
         of assets/logo.svg; regenerate it when the logo changes. -->
    <PackageIcon>icon.png</PackageIcon>

    <!-- Release notes tab on nuget.org: points at the changelog as of the release tag. -->
    <PackageReleaseNotes>https://github.com/italia/pdnd-metadata-dotnet/blob/v$(VersionPrefix)/CHANGELOG.md</PackageReleaseNotes>

    <!-- Fails the pack when the public API breaks binary compatibility with the last published
         release. Raise the baseline after each release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>

    <!-- Build quality -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- SourceLink for debugger support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>

  <!-- Packed only by the projects that produce a package; inert in tests and samples. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
